# =====================================================================
# ParentConnect - variables d'environnement Docker Compose
# Copier ce fichier :  cp .env.example .env   puis adapter les valeurs.
# Le fichier .env ne doit JAMAIS être versionné.
# =====================================================================

# Profil Spring :
#   dev       -> données de démonstration + endpoint GET /dev/tokens (JWT de test). DÉVELOPPEMENT UNIQUEMENT.
#   (vide)    -> configuration de production (aucun seed, aucun générateur de token)
SPRING_PROFILES_ACTIVE=dev

# ---------------------------------------------------------------------
# Authentification Keycloak (realm parentconnect, JWT RS256)
# Clé publique : Keycloak -> Realm settings -> Keys -> RS256 -> "Public key" (valeur Base64)
# Laisser vide en local : seuls les tokens de démonstration du profil dev sont alors acceptés.
KEYCLOAK_REALM_PUBLIC_KEY=
# Émetteur attendu (facultatif), ex. http://keycloak:8080/realms/parentconnect
KEYCLOAK_ISSUER=

# Secret des tokens de démonstration HS256 (GET /dev/tokens), profil dev UNIQUEMENT (32 octets minimum).
# Générer une valeur : openssl rand -base64 48
JWT_SECRET=change-me-with-a-long-random-secret-of-at-least-32-bytes

# Mode relais API Gateway : confiance dans X-Gateway-Auth: verified + X-User-Id / X-User-Role
GATEWAY_RELAY_ENABLED=true

# Clé partagée des appels Participation Service -> Event Service (/internal/**)
# Générer une valeur : openssl rand -hex 32
INTERNAL_API_KEY=change-me-internal-api-key

# Bases de données (une par microservice)
EVENT_DB_USER=events_user
EVENT_DB_PASSWORD=change-me-events-password
PARTICIPATION_DB_USER=participations_user
PARTICIPATION_DB_PASSWORD=change-me-participations-password

# Ports exposés sur la machine hôte (ports différents pour éviter les conflits)
EVENT_SERVICE_HOST_PORT=8085
PARTICIPATION_SERVICE_HOST_PORT=8086
EUREKA_HOST_PORT=8761
EVENT_DB_HOST_PORT=5433
PARTICIPATION_DB_HOST_PORT=5434

# RabbitMQ : true = publication des notifications sur l'exchange parentconnect.topic
# (en local : docker compose --profile rabbitmq up -d --build)
RABBITMQ_ENABLED=false
RABBITMQ_HOST=rabbitmq

# Réconciliation des places (Participation Service)
RECONCILIATION_INTERVAL=PT5M
RECONCILIATION_GRACE_SECONDS=120

TZ=Europe/Paris
