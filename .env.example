# =====================================================================
# ParentConnect — configuration centrale de docker-compose.yml
#
# NE PAS copier à la main : lancer  .\scripts\setup.ps1  (Windows)  ou  ./scripts/setup.sh
# Le script crée .env à partir de ce fichier, génère la paire de clés RSA du realm Keycloak et
# remplace chaque CHANGE_ME par un secret aléatoire. Le fichier .env n'est JAMAIS versionné.
#
# Trois sortes d'URL :
#   - URL HÔTE (navigateur, Postman)     : http://localhost:<port>
#   - URL INTERNE Docker (entre conteneurs) : http://<nom-du-service>:<port>  (jamais localhost)
#   - URL PUBLIQUE du frontend           : http://localhost:4200
# =====================================================================

# ---------------------------------------------------------------------
# Ports publiés sur la machine hôte
# ---------------------------------------------------------------------
FRONTEND_PORT=4200
GATEWAY_PORT=8080
EUREKA_PORT=8761
KEYCLOAK_PORT=8180
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672
# Accès direct aux services (Swagger / démonstration). Le frontend passe UNIQUEMENT par la Gateway.
EVENT_SERVICE_PORT=8085
PARTICIPATION_SERVICE_PORT=8086
POST_SERVICE_PORT=8001
COMMENT_SERVICE_PORT=8002
CATEGORY_SERVICE_PORT=8003
REPORT_SERVICE_PORT=8004
BABYSITTING_SERVICE_PORT=8005
MESSAGING_SERVICE_PORT=8007
MARKETPLACE_SERVICE_PORT=3002
GEO_SERVICE_PORT=8008
CONFIG_SERVER_PORT=8888

# ---------------------------------------------------------------------
# Keycloak (realm parentconnect)
# ---------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_REALM=parentconnect
# URL publique (navigateur) = émetteur "iss" des tokens
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_ISSUER=http://localhost:8180/realms/parentconnect
# URL interne (conteneurs)
KEYCLOAK_INTERNAL_URL=http://keycloak:8180
# Mot de passe des comptes de démonstration non administrateurs (parent_test, parent2_test, pro_test, babysitter_test)
KC_DEMO_PASSWORD=ParentConnect2026!
# Mot de passe des comptes administrateurs (admin, farah) : généré par scripts/setup, appliqué par keycloak-init
KC_APP_ADMIN_PASSWORD=CHANGE_ME
# Secret du client « parentconnect-registration » (inscription des nouveaux parents via l'API Gateway)
KC_REGISTRATION_CLIENT_SECRET=CHANGE_ME
# Paire de clés RSA du realm : générées par scripts/setup (laisser vide ici)
KC_REALM_PRIVATE_KEY=
KEYCLOAK_REALM_PUBLIC_KEY=

# ---------------------------------------------------------------------
# Eureka / RabbitMQ (URL internes)
# ---------------------------------------------------------------------
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/
RABBITMQ_USER=parentconnect
RABBITMQ_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------
# Secrets interservices
# ---------------------------------------------------------------------
# Event Service <- Participation Service (/internal/**)
EVENTS_INTERNAL_API_KEY=CHANGE_ME
# Service Messaging (endpoints internes)
MESSAGING_INTERNAL_API_KEY=CHANGE_ME
# Service Géolocalisation (endpoints internes /internal/geo, en-tête X-Internal-Key)
GEO_INTERNAL_API_KEY=CHANGE_ME
# Sel secret du floutage des positions (~200 m) du service Géolocalisation
GEO_BLUR_SALT=CHANGE_ME
# Secrets HS256 de repli exigés par certains services (non utilisés avec Keycloak RS256)
COMMUNITY_JWT_SECRET=CHANGE_ME
# Clés de chiffrement Laravel (APP_KEY) des 4 services Communauté : générées par scripts/setup
POST_APP_KEY=CHANGE_ME_APP_KEY
COMMENT_APP_KEY=CHANGE_ME_APP_KEY
CATEGORY_APP_KEY=CHANGE_ME_APP_KEY
REPORT_APP_KEY=CHANGE_ME_APP_KEY
MARKETPLACE_JWT_SECRET=CHANGE_ME

# ---------------------------------------------------------------------
# Bases de données (une par service)
# ---------------------------------------------------------------------
EVENT_DB_PASSWORD=CHANGE_ME
PARTICIPATION_DB_PASSWORD=CHANGE_ME
POST_DB_PASSWORD=CHANGE_ME
COMMENT_DB_PASSWORD=CHANGE_ME
CATEGORY_DB_PASSWORD=CHANGE_ME
REPORT_DB_PASSWORD=CHANGE_ME
BABYSITTING_DB_PASSWORD=CHANGE_ME

TZ=Europe/Paris
