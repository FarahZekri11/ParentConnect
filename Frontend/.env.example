# ============================================================
# .env.example – ParentConnect Frontend (React + Vite)
# Copiez en .env.local et remplissez les valeurs.
# NE PAS committer .env.local en version control.
# ============================================================

# URL de l'API Gateway centralisé (JAMAIS un port microservice direct !)
# En développement local : http://localhost:8080
# En production Docker   : http://parentconnect-gateway:8080
VITE_API_BASE_URL=http://localhost:8080

# Nom de l'application (affiché dans le titre)
VITE_APP_NAME=ParentConnect
