# ==============================================================================
# Geo & Neighborhood Service - Environment Configuration
# ==============================================================================

# Server & Port Configuration (Standard: 0.0.0.0:8080)
PORT=8080
HOST=0.0.0.0

# MongoDB Configuration
MONGO_URL=mongodb://geo-mongo:27017
MONGO_DB=geo_db

# RabbitMQ Configuration (Topic exchange: parentconnect.topic)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=parentconnect.topic
RABBITMQ_EVENTS_QUEUE=geo_events_queue
RABBITMQ_DLQ=geo.dlq

# Eureka Service Discovery
EUREKA_ENABLED=true
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/
EUREKA_APP_NAME=PARENTCONNECT-GEO-SERVICE
EUREKA_INSTANCE_HOST=geo-service
EUREKA_INSTANCE_PORT=8080
EUREKA_HEARTBEAT_INTERVAL=30

# Keycloak JWT Authentication (RS256) & Security
KEYCLOAK_REALM_PUBLIC_KEY=""
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY=""
JWT_SECRET=super-secret-key-for-hs256-only

# Internal Services Communication (Constant-time token verification)
INTERNAL_API_KEY=parentconnect-internal-geo-secret-key-32ch

# Geo Search & Privacy
MAX_SEARCH_RADIUS_M=10000
LOCATION_BLUR_M=200
BLUR_SALT=parentconnect-geo-blur-salt-secret

# Neighbor Address Verification
ADDRESS_VERIFICATION_THRESHOLD=2

# Observability
LOG_LEVEL=INFO
ENVIRONMENT=development
