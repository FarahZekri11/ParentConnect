# ==============================================================================
# Geo & Neighborhood Service - Environment Configuration
# ==============================================================================

# MongoDB Configuration
MONGO_URL=mongodb://geo-mongo:27017
MONGO_DB=geo_db

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# JWT Authentication (Local validation, no call to Identity service)
# Configurable: RS256 (default, using JWT_PUBLIC_KEY) or HS256 (using JWT_SECRET)
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAoYgjr3q8yAVJCdBbq8sd\nnAOi2K+ZUWkyRlA4szwXcCO3fE9ehkGRZllZ8/QpRWqJcFYavQm4LanyLXyru0M3\nsDCD9AEWuE7Q4rsWd1bcb7jJCMutimMYx6ktRgBqWhIjmwrQXfYbLeqefHnNoA3O\nEqChf3szBzIVx8LFUttvMpyudcj7hSNn7Zeu819ThikZPTlL2yF4viFTKt82CS7a\nG3QdfY2MosjbWa/ZFkGAULSPfYbMZ7YOpO6h7gVgQOK/c5tA3ih3yFqYksoCP1RU\ngzqeVWl7fjlXP2Rdl5/WJ+Ej5MWlrB+GyYMqkgfBUj3ZHAcQFuz+EOgGTQCR3Dln\nmwIDAQAB\n-----END PUBLIC KEY-----"
JWT_SECRET=super-secret-key-for-hs256-only

# Internal Services Communication (Constant-time token verification)
INTERNAL_API_KEY=parentconnect-internal-geo-secret-key-32ch

# Geo Search & Privacy
MAX_SEARCH_RADIUS_M=10000
LOCATION_BLUR_M=200
BLUR_SALT=parentconnect-geo-blur-salt-secret

# Neighbor Address Verification
ADDRESS_VERIFICATION_THRESHOLD=2

# Observability
LOG_LEVEL=INFO
ENVIRONMENT=development
