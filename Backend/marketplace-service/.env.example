# Server Configuration
PORT=3002
NODE_ENV=development

# MongoDB Database Configuration (isolated per microservice)
MONGODB_URI=mongodb://localhost:27017/parentconnect_marketplace

# JWT Configuration (fallback secret for direct token verification)
JWT_SECRET=parentconnect_jwt_secret_key

# Keycloak OpenID Connect / OAuth2 Configuration
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=parentconnect
KEYCLOAK_CLIENT_ID=marketplace-service

# RabbitMQ Message Broker Configuration (Event-driven asynchronous messaging)
RABBITMQ_URI=amqp://localhost:5672
RABBITMQ_EXCHANGE=parentconnect.marketplace.exchange
RABBITMQ_QUEUE=parentconnect.marketplace.queue

# Eureka Service Discovery Configuration
EUREKA_HOST=localhost
EUREKA_PORT=8761
EUREKA_SERVICE_PATH=/eureka/apps/
APP_NAME=MARKETPLACE-SERVICE
