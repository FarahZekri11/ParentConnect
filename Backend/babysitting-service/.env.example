# ==============================================================================
# ParentConnect – Babysitting Microservice (.env.example)
# ==============================================================================

# ── Service Port (Standardisé: 8080) ─────────────────────────────────────────
PORT=8080
APP_PORT=8080
SERVICE_PORT=8080
SERVICE_NAME=babysitting-service
SERVICE_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Base de données PostgreSQL dédiée ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://babysitting:babysitting_pass@localhost:5432/babysitting_db

# ── Cache Redis dédié ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ── Sécurité & Authentification Keycloak (RS256) ──────────────────────────────
# Clé publique RSA du Realm 'parentconnect' (format PEM ou base64 brute)
KEYCLOAK_REALM_PUBLIC_KEY=
KEYCLOAK_REALM=parentconnect
JWT_ALGORITHM=RS256

# Fallback pour environnement de test local (HS256)
JWT_SECRET=dev-secret-key-for-local-testing-only-1234567890
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Service Discovery (Eureka Server) ─────────────────────────────────────────
EUREKA_ENABLED=true
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/
EUREKA_APP_NAME=PARENTCONNECT-BABYSITTING
EUREKA_INSTANCE_HOST=babysitting-service
EUREKA_HEARTBEAT_INTERVAL=30
EUREKA_LEASE_DURATION=90

# ── Messagerie Événementielle RabbitMQ ─────────────────────────────────────────
RABBITMQ_ENABLED=true
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=parentconnect.topic
RABBITMQ_QUEUE=babysitting_events_queue

# ── Communication Inter-Services ──────────────────────────────────────────────
USE_MOCK_IDENTITY=false
IDENTITY_SERVICE_URL=http://identity-service:8080
