# ==============================================================================
# Babysitting Service - Exemple de configuration (.env.example)
# Copiez ce fichier : cp .env.example .env  puis adaptez les valeurs
# ==============================================================================

# ── Environnement ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Service ────────────────────────────────────────────────────────────────────
SERVICE_PORT=8002
SERVICE_NAME=babysitting-service
SERVICE_VERSION=0.1.0

# ── Base de données (PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://USER:PASS@localhost:5432/babysitting_db

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_256_BIT_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Identity service ───────────────────────────────────────────────────────────
USE_MOCK_IDENTITY=true
IDENTITY_SERVICE_URL=http://localhost:8001

# ── Eureka Service Discovery ───────────────────────────────────────────────────
# true  = s'enregistre dans Eureka au démarrage
# false = démarre sans Eureka (utile en test unitaire)
EUREKA_ENABLED=true

# Mode local (sans Docker) :
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# Mode Docker (réseau interne) :
# EUREKA_SERVER_URL=http://eureka-server:8761/eureka/

EUREKA_APP_NAME=PARENTCONNECT-BABYSITTING
EUREKA_INSTANCE_HOST=localhost
EUREKA_HEARTBEAT_INTERVAL=30
EUREKA_LEASE_DURATION=90
