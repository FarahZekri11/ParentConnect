# Environnement général
PORT=8085
APP_ENV=development

# Base de données MongoDB dédiée (Database per service)
MONGO_URL=mongodb://localhost:27018
MONGO_DB=messaging_db

# Redis (Présence, Compteur non lus, Pub/Sub pour scaling multi-instances)
REDIS_URL=redis://localhost:6379/0

# RabbitMQ (Bus d'événements plateforme)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Authentification JWT (partagé avec le service Identity)
# Valeurs possibles : HS256 ou RS256
JWT_ALGORITHM=HS256
JWT_SECRET=change-me-in-production-parentconnect-secret
JWT_PUBLIC_KEY=

# Clé pour sécuriser les routes internes privées (inter-services direct)
INTERNAL_API_KEY=internal-secret-key-parentconnect

# Limites de sécurité métier
MAX_MESSAGE_LENGTH=2000

# Service Discovery (Spring Cloud Eureka)
EUREKA_ENABLED=true
EUREKA_SERVER_URL=http://localhost:8761/eureka
SERVICE_NAME=MESSAGING-SERVICE
INSTANCE_HOST=localhost

