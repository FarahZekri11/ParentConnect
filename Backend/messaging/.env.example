# ============================================================
# .env.example – Messaging Service (Go / Gin)
# Copiez ce fichier en .env et remplissez les valeurs réelles.
# NE JAMAIS committer le fichier .env en version control.
# ============================================================

# ── Général ─────────────────────────────────────────────────
# Port interne standardisé ParentConnect (défaut : 8080)
PORT=8080
APP_ENV=development

# ── Base de données MongoDB dédiée (Database per service) ───
MONGO_URL=mongodb://messaging-mongo:27017
MONGO_DB=messaging_db

# ── Redis (Présence, Compteurs non lus, Pub/Sub WebSocket) ──
REDIS_URL=redis://redis:6379/0

# ── RabbitMQ (Bus d'événements plateforme) ──────────────────
# Hôte partagé géré par l'intégrateur
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
# Ou en utilisant les variables séparées compatibles avec l'intégrateur :
# RABBITMQ_HOST=rabbitmq
# RABBITMQ_PORT=5672

# ── Authentification Keycloak RS256 (RECOMMANDÉ en production) ──
# Algorithme : RS256 (Keycloak) ou HS256 (Identity service interne)
JWT_ALGORITHM=RS256

# Clé publique RSA du Realm 'parentconnect' Keycloak.
# Valeur PEM brute (multiligne) ou chemin absolu vers un fichier .pem
# Récupérable via : http://<keycloak-host>/realms/parentconnect
# KEYCLOAK_REALM_PUBLIC_KEY a priorité sur JWT_PUBLIC_KEY si les deux sont définis.
KEYCLOAK_REALM_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A...\n-----END PUBLIC KEY-----

# Alias accepté (rétrocompatibilité) :
JWT_PUBLIC_KEY=

# Clé secrète partagée (uniquement si JWT_ALGORITHM=HS256)
JWT_SECRET=

# ── Clé interne inter-services ───────────────────────────────
INTERNAL_API_KEY=internal-secret-key-parentconnect

# ── Limites métier ────────────────────────────────────────────
MAX_MESSAGE_LENGTH=2000

# ── Service Discovery Eureka ─────────────────────────────────
# Serveur Eureka partagé géré par l'intégrateur
EUREKA_ENABLED=true
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/
# Nom d'enregistrement en majuscules (convention : PARENTCONNECT-<SERVICE>)
SERVICE_NAME=PARENTCONNECT-MESSAGING
# Hostname Docker résolvable par Eureka (nom du conteneur)
INSTANCE_HOST=messaging-service

# ── Sécurité Gateway ─────────────────────────────────────────
# Mettre à "true" en production pour exiger que les requêtes
# transitent par l'API Gateway (header X-Forwarded-For obligatoire).
TRUSTED_PROXIES_ENABLED=false
