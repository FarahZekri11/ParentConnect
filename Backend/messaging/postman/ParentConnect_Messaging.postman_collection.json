{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-47a1-b489-e7eefaf3c8a3",
		"name": "ParentConnect - Microservice Messaging",
		"description": "Collection complète des endpoints REST et de la socket WebSocket du microservice Messaging de ParentConnect.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8085",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "VOTRE_TOKEN_JWT_ICI",
			"type": "string"
		},
		{
			"key": "conversation_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "0. Supervision",
			"item": [
				{
					"name": "Liveness Probe (/health)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/health",
							"host": ["{{base_url}}"],
							"path": ["health"]
						}
					}
				},
				{
					"name": "Readiness Probe (/ready)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/ready",
							"host": ["{{base_url}}"],
							"path": ["ready"]
						}
					}
				}
			]
		},
		{
			"name": "1. Conversations",
			"item": [
				{
					"name": "Créer une conversation",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"type\": \"DIRECT\",\n  \"participants\": [\"user-bob-02\"]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/conversations",
							"host": ["{{base_url}}"],
							"path": ["api", "conversations"]
						}
					}
				},
				{
					"name": "Lister mes conversations",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/conversations?page=1&limit=20",
							"host": ["{{base_url}}"],
							"path": ["api", "conversations"],
							"query": [
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "20" }
							]
						}
					}
				},
				{
					"name": "Historique des messages d'une conversation",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/conversations/{{conversation_id}}/messages?limit=50",
							"host": ["{{base_url}}"],
							"path": ["api", "conversations", "{{conversation_id}}", "messages"],
							"query": [
								{ "key": "limit", "value": "50" }
							]
						}
					}
				},
				{
					"name": "Marquer une conversation comme lue",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/conversations/{{conversation_id}}/read",
							"host": ["{{base_url}}"],
							"path": ["api", "conversations", "{{conversation_id}}", "read"]
						}
					}
				}
			]
		},
		{
			"name": "2. Messages",
			"item": [
				{
					"name": "Envoyer un message",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"conversation_id\": \"{{conversation_id}}\",\n  \"content\": \"Bonjour ! Peux-tu me dépanner pour la sortie d'école aujourd'hui ?\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/messages",
							"host": ["{{base_url}}"],
							"path": ["api", "messages"]
						}
					}
				}
			]
		},
		{
			"name": "3. Notifications",
			"item": [
				{
					"name": "Lister les notifications",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/notifications?page=1&limit=20&unread_only=false",
							"host": ["{{base_url}}"],
							"path": ["api", "notifications"],
							"query": [
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "20" },
								{ "key": "unread_only", "value": "false" }
							]
						}
					}
				},
				{
					"name": "Compteur de non-lus (Badge)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/notifications/unread-count",
							"host": ["{{base_url}}"],
							"path": ["api", "notifications", "unread-count"]
						}
					}
				},
				{
					"name": "Marquer toutes les notifications comme lues",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/notifications/read-all",
							"host": ["{{base_url}}"],
							"path": ["api", "notifications", "read-all"]
						}
					}
				}
			]
		}
	]
}
