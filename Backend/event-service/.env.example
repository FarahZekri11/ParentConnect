# =====================================================================
# Event Service — variables de docker-compose.service.yml (intégration)
# Copier : cp .env.example .env   (ne jamais versionner .env)
# =====================================================================

# Base de données dédiée
EVENT_DB_USER=events_user
EVENT_DB_PASSWORD=change-me-events-password

# Keycloak : realm parentconnect -> Realm settings -> Keys -> RS256 -> "Public key"
KEYCLOAK_REALM_PUBLIC_KEY=
# Facultatif : émetteur attendu (claim iss), ex. http://keycloak:8080/realms/parentconnect
KEYCLOAK_ISSUER=
GATEWAY_RELAY_ENABLED=true

# Serveurs partagés de l'intégrateur
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/
RABBITMQ_ENABLED=true
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Clé partagée avec Participation Service (même valeur des deux côtés). Générer : openssl rand -hex 32
INTERNAL_API_KEY=change-me-internal-api-key

TZ=Europe/Paris
