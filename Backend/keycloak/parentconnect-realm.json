{
  "realm": "parentconnect",
  "enabled": true,
  "displayName": "ParentConnect Community Platform",
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "ParentConnect standard user role"
      },
      {
        "name": "ADMIN",
        "description": "ParentConnect administrator role"
      },
      {
        "name": "PARENT",
        "description": "Parent membre de la communauté ParentConnect"
      },
      {
        "name": "PROFESSIONAL",
        "description": "Professionnel de l'enfance (babysitter, éducateur...)"
      }
    ],
    "client": {
      "marketplace-service": [
        {
          "name": "MANAGE_LISTINGS",
          "description": "Manage community listings"
        },
        {
          "name": "BORROW_ITEMS",
          "description": "Borrow equipment"
        }
      ]
    }
  },
  "groups": [],
  "defaultRoles": [
    "USER",
    "PARENT",
    "offline_access",
    "uma_authorization"
  ],
  "clients": [
    {
      "clientId": "marketplace-service",
      "name": "Marketplace Microservice Resource Server",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": false
    },
    {
      "clientId": "api-gateway",
      "name": "ParentConnect API Gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8080/*",
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://localhost:8080"
      ]
    },
    {
      "clientId": "frontend-parentconnect",
      "name": "Angular Frontend Application",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://localhost:8080"
      ]
    }
  ],
