# =====================================================================
# Participation Service — variables de docker-compose.service.yml (intégration)
# Copier : cp .env.example .env   (ne jamais versionner .env)
# =====================================================================

# Base de données dédiée
PARTICIPATION_DB_USER=participations_user
PARTICIPATION_DB_PASSWORD=change-me-participations-password

# Keycloak : realm parentconnect -> Realm settings -> Keys -> RS256 -> "Public key"
KEYCLOAK_REALM_PUBLIC_KEY=
# Facultatif : émetteur attendu (claim iss), ex. http://keycloak:8080/realms/parentconnect
KEYCLOAK_ISSUER=
GATEWAY_RELAY_ENABLED=true

# Serveurs partagés de l'intégrateur
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/
RABBITMQ_ENABLED=true
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Event Service sur le réseau partagé + clé identique à celle d'Event Service
EVENT_SERVICE_URL=http://event-service:8080
INTERNAL_API_KEY=change-me-internal-api-key

# Réconciliation des places
RECONCILIATION_INTERVAL=PT5M
RECONCILIATION_GRACE_SECONDS=120

TZ=Europe/Paris
