# =============================================================================
# ParentConnect Microservices Architecture — Environment Variables Example
# Copy this file to .env and adjust variables for your local or production setup
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Shared Infrastructure Credentials
# -----------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8180
KEYCLOAK_REALM=parentconnect
KEYCLOAK_CLIENT_ID=frontend-parentconnect

RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

DISCOVERY_SERVER_PORT=8761
API_GATEWAY_PORT=8080

# -----------------------------------------------------------------------------
# 2. Marketplace Microservice (NestJS + MongoDB)
# -----------------------------------------------------------------------------
MARKETPLACE_PORT=3002
MONGODB_URI=mongodb://localhost:27017/parentconnect_marketplace
JWT_SECRET=parentconnect_jwt_secret_key_2026_super_secure
KEYCLOAK_URL=http://localhost:8180
RABBITMQ_URI=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=parentconnect.marketplace.exchange
RABBITMQ_QUEUE=parentconnect.marketplace.queue
EUREKA_HOST=localhost
EUREKA_PORT=8761

# -----------------------------------------------------------------------------
# 3. Microservices Integration Matrix (For Teammates)
# -----------------------------------------------------------------------------
# Service 1: Marketplace (Assigned to Farah) -> Port 3002
# Service 2: Identity / User Service        -> Port 8081 / Keycloak 8180
# Service 3: Babysitting Service            -> Port 8084 (Suggested)
# Service 4: Community & Posts Service      -> Port 8085 (Suggested)
# Service 5: Events & Workshops Service     -> Port 8086 (Suggested)
# Service 6: Notification & Chat Service    -> Port 8087 (Suggested)
