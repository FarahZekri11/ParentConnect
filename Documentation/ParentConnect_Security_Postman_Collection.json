        }
      ]
    },
    {
      "name": "3. 📋 CRUD Complet Posts (via Gateway)",
      "item": [
        {
          "name": "3.1 Lister tous les Posts — Public",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{gateway_url}}/api/posts", "host": ["{{gateway_url}}"], "path": ["api", "posts"] }
          }
        },
        {
          "name": "3.2 Créer un Post — PARENT (Keycloak RS256)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{keycloak_parent_token}}" }
            ],
            "body": {
              "mode": "raw",
