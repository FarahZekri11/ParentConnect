              "host": ["{{gateway_url}}"],
              "path": ["api", "categories"]
            },
            "description": "POST /api/categories avec token PARENT. La création de catégorie est réservée aux ADMIN → 403."
          }
        },
        {
          "name": "✅ Test 7 : Rôle ADMIN sur Ressource ADMIN (Attendu : 201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Test 7 : Rôle ADMIN autorisé → 201', function() {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "console.log('Test 7 | Status:', pm.response.code, '| Attendu: 201');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{keycloak_admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nutrition et Éveil (Keycloak)\",\n  \"description\": \"Conseils en nutrition pour les tout-petits — créé via Keycloak RS256.\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/categories",
              "host": ["{{gateway_url}}"],
              "path": ["api", "categories"]
            },
            "description": "POST /api/categories avec token ADMIN Keycloak. Doit retourner 201."
          }
        },
        {
          "name": "✅ Test 8 : Inscription + Login + Accès Protégé (Flux Complet)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Test 8 : Statut 2xx ou token présent', function() {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
