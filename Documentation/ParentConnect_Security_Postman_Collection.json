            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Catégorie Interdite (PARENT)\",\n  \"description\": \"Un PARENT n'a pas le droit de créer une catégorie.\"\n}"
            },
            "url": {
