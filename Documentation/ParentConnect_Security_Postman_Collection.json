            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": 1,\n  \"type\": \"post\",\n  \"title\": \"Token expiré test\",\n  \"content\": \"Token périmé depuis 2020.\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/posts",
              "host": ["{{gateway_url}}"],
              "path": ["api", "posts"]
            },
            "description": "Token avec exp=1600000001 (expiré depuis 2020). Le Gateway retourne 401."
          }
        },
        {
          "name": "🚫 Test 6 : Rôle PARENT sur Ressource ADMIN (Attendu : 403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Test 6 : Rôle insuffisant → 403', function() {",
                  "    pm.expect(pm.response.code).to.equal(403);",
                  "});",
                  "console.log('Test 6 | Status:', pm.response.code, '| Attendu: 403');"
                ],
                "type": "text/javascript"
