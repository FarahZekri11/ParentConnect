{
  "info": {
    "name": "ParentConnect - Tests Sécurité Microservices (Keycloak + JWT)",
    "description": "Collection complète pour valider les 8 exigences de sécurité de l'architecture ParentConnect. Authentification centralisée via Keycloak (RS256) avec compatibilité tokens custom HS256. Tous les tests passent par l'API Gateway (port 8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "keycloak_url",
      "value": "http://localhost:8180",
      "type": "string"
    },
    {
      "key": "keycloak_realm",
      "value": "parentconnect",
      "type": "string"
    },
    {
      "key": "keycloak_client",
      "value": "parentconnect-gateway",
      "type": "string"
    },
    {
      "key": "user_jwt_token",
      "value": "",
      "type": "string",
      "description": "Token JWT de l'utilisateur connecté (PARENT)"
    },
    {
      "key": "admin_jwt_token",
      "value": "",
      "type": "string",
      "description": "Token JWT de l'administrateur"
    },
    {
      "key": "keycloak_parent_token",
      "value": "",
      "type": "string",
      "description": "Token Keycloak RS256 pour un utilisateur PARENT"
    },
    {
      "key": "keycloak_admin_token",
      "value": "",
      "type": "string",
      "description": "Token Keycloak RS256 pour un ADMIN"
    }
  ],
  "item": [
    {
      "name": "0. 🔑 Keycloak — Obtention de Tokens (IdP Central)",
      "description": "Prérequis : Keycloak doit être démarré sur le port 8180. Exécutez start-all.bat en premier.\n\nConfiguration Keycloak requise :\n1. Realm 'parentconnect' créé\n2. Client 'parentconnect-gateway' (Direct Access Grants activé)\n3. Rôles : ADMIN, PARENT, PROFESSIONAL\n4. Utilisateurs test : admin_test/Admin@2026, parent_test/Parent@2026",
      "item": [
        {
          "name": "0.1 Token Keycloak — Utilisateur PARENT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('keycloak_parent_token', jsonData.access_token);",
                  "    pm.collectionVariables.set('user_jwt_token', jsonData.access_token);",
                  "    console.log('✅ Token PARENT Keycloak obtenu et sauvegardé');",
                  "} else {",
                  "    console.error('❌ Échec obtention token:', JSON.stringify(jsonData));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password" },
                { "key": "client_id", "value": "{{keycloak_client}}" },
                { "key": "username", "value": "parent_test" },
                { "key": "password", "value": "Parent@2026" },
                { "key": "scope", "value": "openid" }
              ]
            },
            "url": {
              "raw": "{{keycloak_url}}/realms/{{keycloak_realm}}/protocol/openid-connect/token",
              "host": ["{{keycloak_url}}"],
              "path": ["realms", "{{keycloak_realm}}", "protocol", "openid-connect", "token"]
            }
          }
        },
        {
          "name": "0.2 Token Keycloak — Administrateur ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('keycloak_admin_token', jsonData.access_token);",
                  "    pm.collectionVariables.set('admin_jwt_token', jsonData.access_token);",
                  "    console.log('✅ Token ADMIN Keycloak obtenu et sauvegardé');",
                  "} else {",
                  "    console.error('❌ Échec obtention token ADMIN:', JSON.stringify(jsonData));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password" },
                { "key": "client_id", "value": "{{keycloak_client}}" },
                { "key": "username", "value": "admin_test" },
                { "key": "password", "value": "Admin@2026" },
                { "key": "scope", "value": "openid" }
              ]
            },
            "url": {
              "raw": "{{keycloak_url}}/realms/{{keycloak_realm}}/protocol/openid-connect/token",
              "host": ["{{keycloak_url}}"],
              "path": ["realms", "{{keycloak_realm}}", "protocol", "openid-connect", "token"]
            }
          }
        },
        {
          "name": "0.3 Keycloak — Clé Publique du Realm (RS256)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{keycloak_url}}/realms/{{keycloak_realm}}",
              "host": ["{{keycloak_url}}"],
              "path": ["realms", "{{keycloak_realm}}"]
            },
            "description": "Renvoie les métadonnées du realm, incluant la clé publique RSA utilisée pour vérifier les tokens RS256."
          }
        },
        {
          "name": "0.4 Keycloak — Vérifier Token (Introspection)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "client_id", "value": "{{keycloak_client}}" },
                { "key": "token", "value": "{{keycloak_parent_token}}" }
              ]
            },
            "url": {
              "raw": "{{keycloak_url}}/realms/{{keycloak_realm}}/protocol/openid-connect/token/introspect",
              "host": ["{{keycloak_url}}"],
              "path": ["realms", "{{keycloak_realm}}", "protocol", "openid-connect", "token", "introspect"]
            }
          }
        }
      ]
    },
    {
      "name": "1. 👤 Authentification & Utilisateurs (via Gateway)",
      "item": [
        {
          "name": "1.1 Inscription (Register) — Public",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Feriel Benali\",\n  \"email\": \"feriel.test@parentconnect.fr\",\n  \"password\": \"monSecret123\",\n  \"role\": \"PARENT\",\n  \"phone\": \"+33612345678\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/auth/register",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Endpoint PUBLIC — aucun token requis. Doit retourner 201."
          }
        },
        {
          "name": "1.2 Connexion (Login) — Public, Token HS256",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('user_jwt_token', jsonData.access_token);",
                  "    console.log('✅ Token HS256 sauvegardé dans user_jwt_token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"feriel.test@parentconnect.fr\",\n  \"password\": \"monSecret123\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/auth/login",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Endpoint PUBLIC — retourne un token JWT HS256 (token custom)."
          }
        },
        {
          "name": "1.3 Profil Connecté (/auth/me) — Protégé",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{user_jwt_token}}" }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/auth/me",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "1.4 Liste des Utilisateurs — ADMIN uniquement",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_jwt_token}}" }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/users",
              "host": ["{{gateway_url}}"],
              "path": ["api", "users"]
            }
          }
        }
      ]
    },
    {
      "name": "2. 🔒 Validation des 8 Exigences de Sécurité",
      "description": "Tests obligatoires couvrant les 8 scénarios de sécurité demandés par le professeur.",
      "item": [
        {
          "name": "✅ Test 1 : Endpoint Public SANS Token (Attendu : 200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Test 1 : Endpoint public accessible sans token', function() {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});",
                  "console.log('Test 1 | Status:', pm.response.code, '| Attendu: 200');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/posts",
              "host": ["{{gateway_url}}"],
              "path": ["api", "posts"]
            },
            "description": "GET /api/posts sans aucun token d'authentification. L'endpoint est public et doit retourner 200."
          }
        },
        {
          "name": "🚫 Test 2 : Endpoint Protégé SANS Token (Attendu : 401 Unauthorized)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Test 2 : Endpoint protégé refusé sans token → 401', function() {",
                  "    pm.expect(pm.response.code).to.equal(401);",
                  "});",
                  "console.log('Test 2 | Status:', pm.response.code, '| Attendu: 401');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": 1,\n  \"type\": \"post\",\n  \"title\": \"Tentative sans token\",\n  \"content\": \"Ce post ne doit pas être créé.\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/posts",
              "host": ["{{gateway_url}}"],
              "path": ["api", "posts"]
            },
            "description": "POST /api/posts sans token. Le Gateway doit retourner 401 Unauthorized."
          }
        },
        {
          "name": "✅ Test 3 : Token Keycloak RS256 Valide (Attendu : 201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Test 3 : Token Keycloak RS256 valide → 201', function() {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "console.log('Test 3 | Status:', pm.response.code, '| Attendu: 201');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{keycloak_parent_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": 1,\n  \"type\": \"question\",\n  \"title\": \"Conseils sommeil bébé 8 mois (Keycloak RS256)\",\n  \"content\": \"Avez-vous des astuces pour aider bébé à faire ses nuits ?\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/posts",
              "host": ["{{gateway_url}}"],
              "path": ["api", "posts"]
            },
            "description": "POST /api/posts avec token Keycloak RS256 valide. Exécutez d'abord '0.1 Token PARENT' pour obtenir le token."
          }
        },
        {
          "name": "🚫 Test 4 : Token Invalide / Falsifié (Attendu : 401 Unauthorized)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Test 4 : Token falsifié refusé → 401', function() {",
                  "    pm.expect(pm.response.code).to.equal(401);",
                  "});",
