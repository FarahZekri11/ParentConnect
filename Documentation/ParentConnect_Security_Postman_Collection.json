          }
        },
        {
          "name": "3.4 Modifier un Post — Propriétaire (Keycloak RS256)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{keycloak_parent_token}}" }
            ],
            "body": {
